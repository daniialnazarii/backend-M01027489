            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Every result contains 'art'\", function () {\r\n    pm.response.json().forEach(function (lesson) {\r\n        const text = [lesson.subject, lesson.location, lesson.price, lesson.spaces, lesson.tutor]\r\n            .join(\" \").toLowerCase();\r\n        pm.expect(text).to.include(\"art\");\r\n    });\r\n});"
            ]
