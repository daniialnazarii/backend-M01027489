          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Every teacher has a first name, last name and lessons\", function () {\r\n    pm.response.json().forEach(function (teacher) {\r\n        pm.expect(teacher).to.have.property(\"firstName\");\r\n        pm.expect(teacher).to.have.property(\"lastName\");\r\n        pm.expect(teacher.lessonIds.length).to.be.above(0);\r\n    });\r\n});"
            ]
          }
        }
